{
  "name": "use-typewriter-animation",
  "version": "3.5.2",
  "description": "Tiny, fast typewriter animations for React 18 and 19. Hook, component and framework-agnostic engine.",
  "license": "MIT",
  "author": {
    "name": "Dogu Yilmaz",
    "url": "https://github.com/doguyilmaz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doguyilmaz/use-typewriter-animation.git"
  },
  "bugs": {
    "url": "https://github.com/doguyilmaz/use-typewriter-animation/issues"
  },
  "homepage": "https://doguyilmaz.github.io/use-typewriter-animation",
  "keywords": [
    "react",
    "hook",
    "typewriter",
    "typing",
    "animation",
    "text-animation",
    "react-compiler"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:compiler": "REACT_COMPILER=1 vitest run",
    "test:all": "bun run test && bun run test:compiler",
    "doctor": "react-doctor . --no-telemetry --yes --blocking warning",
    "compiler": "react-compiler-marker --exclude-dirs node_modules,dist,build,.docusaurus,coverage,tests .",
    "size": "node scripts/size.js",
    "check": "bun run lint && bun run typecheck && bun run test:all && bun run build && bun run smoke && bun run size",
    "preversion": "bun run check",
    "postversion": "git push --follow-tags",
    "prepublishOnly": "bun run build",
    "docs:dev": "cd docs && bun run start",
    "docs:build": "cd docs && bun run build",
    "smoke": "node scripts/smoke.js"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@babel/core": "^7.28.0",
    "@biomejs/biome": "^2.5.15",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.14.5",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-compiler-marker": "^0.2.0",
    "react-doctor": "^0.9.17",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
